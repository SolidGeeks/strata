# Copy to .env, then set at least EDIT_PASS. See section 3 of the README.

# First admin account, recreated or reset on every start
EDIT_USER=admin
EDIT_PASS=
# Or read it from a file (Docker secrets, systemd credentials): EDIT_PASS_FILE=/run/secrets/strata-admin
# (VIEW_PASS_FILE likewise). The file wins over the variable.

# Shared read-only account (ignored while VIEW_PASS is empty)
VIEW_USER=viewer
VIEW_PASS=

ALLOW_SELF_APPROVAL=false
HISTORY_KEEP=5000
READ_ONLY=false
BACKUP_KEEP=14
BACKUP_EVERY_HOURS=24
MAX_IMPORT_MB=20

# Failed sign-ins: after LOGIN_MAX_FAILS different wrong passwords for one account, or
# LOGIN_MAX_FAILS_PER_ADDRESS from one client, sign-ins are refused for LOGIN_LOCK_MINUTES (0 = off)
LOGIN_MAX_FAILS=10
LOGIN_MAX_FAILS_PER_ADDRESS=20
LOGIN_LOCK_MINUTES=15
# Behind a reverse proxy: the proxies whose X-Forwarded-For gives the client address
# (loopback, private, addresses or IPv4 ranges). With the bundled Caddy: private
# TRUST_PROXY=loopback

PORT=8080
HOST=0.0.0.0

# Data folder. Docker already uses /data; set it only for a run without Docker.
# DATA_DIR=/var/lib/strata

# Single sign-on with OpenID Connect (Entra ID, Keycloak, Authentik, Google Workspace, Okta…).
# Register Strata at your provider with the redirect URI <PUBLIC_URL>/auth/oidc/callback.
# PUBLIC_URL=https://strata.example.org
# SSO_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=            # or SSO_CLIENT_SECRET_FILE=/run/secrets/strata-sso
# SSO_NAME=Microsoft Entra ID   # the sign-in button: "Sign in with …"
# Groups (from the groups claim) that give each role, comma-separated; the highest one wins
# SSO_ROLE_ADMIN=strata-admins
# SSO_ROLE_APPROVER=soc
# SSO_ROLE_CONTRIBUTOR=it-ops
# SSO_ROLE_VIEWER=
# SSO_DEFAULT_ROLE=             # role of people in none of those groups (empty: no access)
# SSO_USER_CLAIM=preferred_username
# SSO_GROUPS_CLAIM=groups       # Entra ID: groups (object ids) or roles (app roles)
# Or a sign-in proxy (Authelia, oauth2-proxy…) gives the user and groups in headers, believed only from
# the address(es) in SSO_HEADER_TRUST (exact addresses, no range):
# SSO_HEADER_USER=Remote-User
# SSO_HEADER_GROUPS=Remote-Groups
# SSO_HEADER_TRUST=127.0.0.1
# Local accounts once single sign-on is on: all (default), admins (break-glass only) or off
# LOCAL_LOGIN=all
# SESSION_HOURS=8

# Connectors (Cyberwatch, GLPI, phpIPAM, Palo Alto, and modules). Set to false to turn them off.
# CONNECTORS=false
# Module store: the registry the admin installs modules from ("off": none). Installed modules go to
# DATA_DIR/modules. MODULES_DIR: a folder of modules you provide yourself (docker-compose.yml).
# MODULE_REGISTRY=https://solidgeeks.github.io/strata/modules/index.json
# MODULE_UPLOAD=false
# MODULES_DIR=/modules
# Longest a connector run may take before it is stopped
# CONNECTOR_TIMEOUT_MINUTES=30

# "Source code" link in the app (AGPL). Point it at your fork if you modify Strata.
# SOURCE_URL=https://github.com/SolidGeeks/strata

# DNS name for the HTTPS proxy (docker compose --profile https)
# SITE_ADDRESS=strata.example.lan

