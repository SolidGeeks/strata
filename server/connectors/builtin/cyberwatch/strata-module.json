{
  "strataModule": 1,
  "id": "cyberwatch",
  "name": "Cyberwatch",
  "version": "0.8.0",
  "description": "Vulnerabilities (CVE) of the assets, matched by host name or IP address",
  "author": "Solid Geeks",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/SolidGeeks/strata",
  "main": "index.js",
  "badge": "CVE",
  "permissions": {
    "map": true,
    "network": true
  },
  "fields": [
    {
      "k": "url",
      "label": "Cyberwatch URL",
      "placeholder": "https://cyberwatch.example.internal",
      "required": true
    },
    {
      "k": "accessKey",
      "label": "API access key",
      "required": true
    },
    {
      "k": "secretKey",
      "label": "API secret key",
      "secret": true,
      "required": true
    },
    {
      "k": "auth",
      "label": "Authentication",
      "type": "select",
      "options": [
        [
          "basic",
          "Basic (access key : secret key)"
        ],
        [
          "hmac",
          "API Auth HMAC-SHA256 (older instances)"
        ]
      ],
      "default": "basic"
    },
    {
      "k": "minLevel",
      "label": "Lowest severity to import",
      "type": "select",
      "options": [
        [
          "low",
          "Low and above"
        ],
        [
          "med",
          "Medium and above"
        ],
        [
          "high",
          "High and above"
        ],
        [
          "crit",
          "Critical only"
        ]
      ],
      "default": "med"
    },
    {
      "k": "maxPerAsset",
      "label": "At most per asset (worst first)",
      "type": "number",
      "default": 40
    },
    {
      "k": "includeIgnored",
      "label": "Also import the CVEs ignored in Cyberwatch",
      "type": "bool",
      "default": false
    },
    {
      "k": "serversPath",
      "label": "API path of the server list",
      "placeholder": "/api/v3/vulnerabilities/servers",
      "advanced": true
    }
  ]
}
